{
  "name": "lead-came-nesting-bench",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "彩绘玻璃铅槽条纯前端精确排料台",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "diffcheck": "vite-node scripts/diffcheck.ts",
    "verify": "tsc --noEmit && vitest run && vite-node scripts/diffcheck.ts && vite build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.9"
  }
}
